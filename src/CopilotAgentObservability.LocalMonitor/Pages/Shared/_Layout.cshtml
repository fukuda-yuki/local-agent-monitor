<!DOCTYPE html>
<html lang="ja" class="monitor-root">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ローカルモニター</title>
    <link rel=stylesheet href=/monitor.css />
</head>
<body>
    <header class="monitor-shell-header">
        <nav class="monitor-shell-breadcrumb" id="shell-breadcrumb" aria-label="パンくず" data-breadcrumb-host>
            @if (IsSectionDefined("ShellBreadcrumb"))
            {
                @await RenderSectionAsync("ShellBreadcrumb", required: false)
            }
            else
            {
                <span class="monitor-shell-breadcrumb-current">Local Monitor</span>
            }
        </nav>
        <div class="monitor-shell-actions">
            <button type="button"
                    class="monitor-shell-action receiver-status-action"
                    id="receiver-status-action"
                    aria-haspopup="dialog"
                    aria-controls="settings-modal">
                <span class="status-dot" id="receiver-status-dot" aria-hidden="true"></span>
                <span id="receiver-status-text" aria-live="polite">確認中…</span>
            </button>
            <button type="button"
                    class="monitor-shell-action"
                    id="settings-action"
                    aria-haspopup="dialog"
                    aria-controls="settings-modal">設定</button>
        </div>
    </header>
    <main class="monitor-content">
        @RenderBody()
    </main>
    <dialog class="settings-modal"
            id="settings-modal"
            aria-modal="true"
            aria-labelledby="settings-modal-title">
        <header class="settings-modal-header">
            <h2 id="settings-modal-title">設定</h2>
            <button type="button"
                    class="settings-modal-close"
                    id="settings-modal-close"
                    aria-label="設定を閉じる">×</button>
        </header>
        <div class="settings-modal-body">
            <nav class="settings-modal-navigation"
                 aria-label="設定セクション"
                 data-settings-navigation-host></nav>
            <div class="settings-modal-content" data-settings-content-host></div>
        </div>
    </dialog>
    <script src=/monitor.js defer></script>
    <script src=/monitor-shell.js defer></script>
</body>
</html>
