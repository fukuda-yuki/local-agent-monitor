@model CopilotAgentObservability.LocalMonitor.Pages.LocalMonitorV1PageModel

<div class="local-monitor-session-workspace"
      data-session-workspace
      data-session-id="@Model.Path!.SessionId">
    <header class="local-monitor-session-context" data-session-context>
        <nav aria-label="パンくず"><a href="/sessions">セッション一覧</a> / <span data-session-breadcrumb>セッション</span></nav>
        <div class="local-monitor-session-title-row"><h1 data-session-title>セッション</h1><button type="button" data-session-overview-open>概要</button><button type="button" data-session-ai-open hidden>AIで分析</button></div>
        <div data-session-context-content role="status" aria-live="polite">セッションを読み込んでいます</div>
    </header>
    <section class="local-monitor-session-summary" data-session-summary aria-label="セッション全体の概要"></section>
    <section class="local-monitor-session-execution-workspace" aria-labelledby="session-execution-heading">
        <h2 class="local-monitor-visually-hidden" id="session-execution-heading">実行タイムライン</h2>
        <div class="local-monitor-session-executions" data-session-executions></div>
        <aside class="local-monitor-session-inspector" data-session-overview aria-label="セッションの概要"></aside>
    </section>
</div>
<dialog class="local-monitor-raw-dialog" data-raw-content-dialog aria-labelledby="local-monitor-raw-dialog-title">
    <div class="local-monitor-raw-dialog-frame">
        <header><h2 id="local-monitor-raw-dialog-title" data-raw-content-title>記録内容</h2><button type="button" data-raw-content-close aria-label="閉じる">×</button></header>
        <div data-raw-content-status role="status" aria-live="polite"></div>
        <pre data-raw-content-text tabindex="0"></pre>
    </div>
</dialog>
<dialog class="local-monitor-ai-dialog" data-session-ai-dialog aria-labelledby="local-monitor-session-ai-title">
    <div class="local-monitor-ai-dialog-frame">
        <header><h2 id="local-monitor-session-ai-title">セッションのAI分析</h2><button type="button" data-session-ai-close>閉じる</button></header>
        <p>選択したセッションと利用可能な記録内容は GitHub Copilot へ送信される場合があります。接続確認の成功は、選択したモデルが使えることや分析成功を保証しません。</p>
        <div data-session-ai-model class="local-monitor-ai-model">
            <label for="local-monitor-session-ai-model">分析に使うモデル</label>
            <select id="local-monitor-session-ai-model" data-session-ai-model-select disabled>
                <option value="">モデルを選択</option>
            </select>
            <button type="button" data-session-ai-model-refresh>モデル一覧を更新</button>
        </div>
        <div data-session-ai-status role="status" aria-live="polite"></div>
        <nav data-session-ai-history aria-label="過去のセッション分析"></nav>
        <div data-session-ai-report></div>
        <footer><button type="button" data-session-ai-regenerate>再分析</button><button type="button" data-session-ai-cancel hidden>キャンセル</button><button type="button" data-session-ai-more hidden>さらに読み込む</button></footer>
    </div>
</dialog>
