@model CopilotAgentObservability.LocalMonitor.Pages.LocalMonitorV1PageModel
@using CopilotAgentObservability.LocalMonitor.LocalMonitorV1
@{
    Layout = "_Layout";
}

@if (Model.PageState is not null && Model.RouteKind is null)
{
    <section data-page-state="@Model.PageState"
             data-recovery-action="@Model.RecoveryAction">
        <div role="status" aria-live="polite">
            <h1>ページを表示できません</h1>
            <p>状態を確認して、もう一度お試しください。</p>
        </div>
    </section>
}
else
{
    <section data-local-monitor-v1-host
             data-fact-state-renderer="shared"
             data-route-kind="@Model.RouteKind?.ToString()"
             data-page-state="@Model.PageState"
             data-recovery-action="@Model.RecoveryAction"
             data-execution-id="@Model.Query?.ExecutionId"
             data-node-id="@Model.Query?.NodeId"
             data-analysis-id="@Model.Query?.AnalysisId">
        @if (Model.PageState is not null)
        {
            <div role="status" aria-live="polite">
                <h1>ページを表示できません</h1>
                <p>状態を確認して、もう一度お試しください。</p>
            </div>
        }
        else if (Model.RouteKind == LocalMonitorV1PrimaryRouteKind.RepositorySelection)
        {
            @await Html.PartialAsync("/Pages/Shared/LocalMonitorV1/_RepositorySelection.cshtml")
        }
        else if (Model.RouteKind is LocalMonitorV1PrimaryRouteKind.RepositorySessions
                 or LocalMonitorV1PrimaryRouteKind.AllSessions
                 or LocalMonitorV1PrimaryRouteKind.UnassignedSessions)
        {
            @await Html.PartialAsync("/Pages/Shared/LocalMonitorV1/_SessionExplorer.cshtml")
        }
        else if (Model.RouteKind == LocalMonitorV1PrimaryRouteKind.SessionDetail)
        {
            @await Html.PartialAsync("/Pages/Shared/LocalMonitorV1/_SessionWorkspace.cshtml")
        }
        else if (Model.RouteKind == LocalMonitorV1PrimaryRouteKind.ComparisonDetail)
        {
            @await Html.PartialAsync("/Pages/Shared/LocalMonitorV1/_RepositoryCompare.cshtml")
        }
    </section>
}

@section LocalMonitorV1Scripts {
    @if (Model.RouteKind is not null)
    {
        <script src="/local-monitor-v1-shared.js" defer></script>
        <script src="/local-monitor-repositories.js" defer></script>
        <script src="/local-monitor-settings.js" defer></script>
    }
    @if (Model.RouteKind is LocalMonitorV1PrimaryRouteKind.RepositorySessions
             or LocalMonitorV1PrimaryRouteKind.AllSessions
             or LocalMonitorV1PrimaryRouteKind.UnassignedSessions)
    {
        <script src="/local-monitor-explorer.js" defer></script>
    }
    else if (Model.RouteKind == LocalMonitorV1PrimaryRouteKind.SessionDetail)
    {
        <script src="/local-monitor-session-workspace.js" defer></script>
    }
    else if (Model.RouteKind == LocalMonitorV1PrimaryRouteKind.ComparisonDetail)
    {
        <script src="/local-monitor-compare.js" defer></script>
    }
}
