@page "/costs"
@model CostsModel

<section class="cost-page" id="cost-root"
         data-session-id="@Model.SessionId"
         data-estimate-id="@Model.EstimateId">
    <div class="overview-head cost-head">
        <div>
            <nav class="breadcrumb" aria-label="パンくず"><a href="/">セッション</a><span class="breadcrumb-sep">›</span><span>費用</span></nav>
            <h2 class="overview-title">推定費用</h2>
            <p class="monitor-subtle">記録から算出した推定費用です。請求額とは異なります。</p>
        </div>
        <span class="monitor-badge">メタデータのみ</span>
    </div>

    <form class="panel cost-filter-panel" id="cost-filters" aria-label="費用の絞り込み">
        <div class="cost-filter-grid">
            <label>開始（UTC）<input id="cost-filter-from" name="from" type="date" required /></label>
            <label>終了（UTC、含まない）<input id="cost-filter-to" name="to" type="date" required /></label>
            <label>ソース<input id="cost-filter-source" name="source_surface" type="text" maxlength="128" autocomplete="off" /></label>
            <label>モデル<input id="cost-filter-model" name="model" type="text" maxlength="256" autocomplete="off" /></label>
            <label>課金方式
                <select id="cost-filter-mode" name="billing_mode">
                    <option value="">すべて</option>
                    <option value="github_ai_credits">github_ai_credits</option>
                    <option value="github_legacy_requests">github_legacy_requests</option>
                    <option value="plan_included">plan_included</option>
                    <option value="anthropic_api_tokens">anthropic_api_tokens</option>
                    <option value="cloud_provider_api_tokens">cloud_provider_api_tokens</option>
                    <option value="subscription">subscription</option>
                    <option value="custom_enterprise">custom_enterprise</option>
                    <option value="unknown">unknown</option>
                </select>
            </label>
            <label>状態
                <select id="cost-filter-status" name="status">
                    <option value="">すべて</option><option value="estimated">推定済み</option><option value="partial">partial</option><option value="not_estimable">not-estimable</option><option value="missing">missing</option><option value="failed">failed</option><option value="unavailable">unavailable</option><option value="stale">stale</option>
                </select>
            </label>
            <label>料金表のバージョン<input id="cost-filter-registry" name="registry_version" type="text" maxlength="128" autocomplete="off" /></label>
            <label>リポジトリ<input id="cost-filter-repository" name="repository" type="text" maxlength="256" autocomplete="off" /></label>
            <label>ワークスペース<input id="cost-filter-workspace" name="workspace" type="text" maxlength="256" autocomplete="off" /></label>
        </div>
        <div class="alert-filter-actions">
            <button type="submit" class="monitor-btn monitor-btn-primary">適用</button>
            <button type="button" class="monitor-btn" id="cost-filter-reset">解除</button>
        </div>
    </form>

    <div id="cost-error" class="error-strip" role="alert" hidden>費用を読み込めませんでした。再試行してください。</div>
    <div id="cost-incomplete" class="panel cost-incomplete" role="note" hidden></div>
    <p id="cost-status" class="monitor-subtle">費用を読み込み中…</p>

    <div class="cost-summary-grid" aria-label="費用の概要">
        <section class="panel cost-overall-card" id="cost-overall" aria-labelledby="cost-overall-heading">
            <div class="panel-head"><h3 class="panel-title" id="cost-overall-heading">算出範囲</h3><span class="panel-meta">推定済み / 対象セッション</span></div>
            <p class="empty-state">読み込んでいます。</p>
        </section>
        <section class="panel cost-totals-card" id="cost-range-totals" aria-labelledby="cost-range-heading">
            <div class="panel-head"><h3 class="panel-title" id="cost-range-heading">期間合計</h3><span class="panel-meta">料金表・通貨別</span></div>
            <div id="cost-range-total-list"></div>
        </section>
    </div>

    <section class="panel" id="cost-daily-trend" aria-labelledby="cost-daily-heading">
        <div class="panel-head"><h3 class="panel-title" id="cost-daily-heading">日別の推移（UTC）</h3><span class="panel-meta">全体の推定額と一部の暫定額</span></div>
        <div id="cost-daily-list" class="cost-trend-list"></div>
    </section>

    <section class="panel" id="cost-groups" aria-labelledby="cost-groups-heading">
        <div class="panel-head"><h3 class="panel-title" id="cost-groups-heading" tabindex="-1">費用の内訳</h3><span class="panel-meta">1ページ最大100件</span></div>
        <div class="monitor-table-wrapper">
            <table class="monitor-table">
                <thead><tr><th scope="col">UTC / 取得元</th><th scope="col">提供元 / モデル / 課金方式</th><th scope="col">料金表 / 内訳</th><th scope="col">算出範囲</th><th scope="col">推定済み</th><th scope="col">一部の暫定額</th></tr></thead>
                <tbody id="cost-group-rows"></tbody>
            </table>
        </div>
        <button type="button" class="monitor-btn" id="cost-groups-next" hidden>次のページ</button>
    </section>

    <section class="panel cost-context" id="cost-session" hidden aria-labelledby="cost-context-heading">
        <div class="panel-head">
            <h3 class="panel-title" id="cost-context-heading" tabindex="-1">セッションの推定費用</h3>
            <span class="panel-meta monitor-mono" id="cost-context-id"></span>
        </div>
        <div id="cost-exact-estimate"></div>
        <div class="cost-context-columns">
            <div><h3 id="cost-estimate-history-heading" tabindex="-1">過去の推定結果</h3><div id="cost-estimate-history"></div></div>
            <div><h3 id="cost-attempt-history-heading" tabindex="-1">再計算の履歴</h3><div id="cost-attempt-history"></div></div>
        </div>
        <div class="cost-action-row">
            <button type="button" class="monitor-btn" id="cost-estimates-next" hidden>推定履歴の続き</button>
            <button type="button" class="monitor-btn" id="cost-attempts-next" hidden>再計算履歴の続き</button>
        </div>
        <div class="cost-action-row">
            <label><input type="checkbox" id="cost-scope-utc-day" /> 該当日の予算（UTC）</label>
            <label><input type="checkbox" id="cost-scope-period" /> 直近期間の予算</label>
            <button type="button" class="monitor-btn monitor-btn-primary" id="cost-recalculate">このセッションを再計算</button>
            <a class="monitor-btn" id="cost-session-alerts" href="/alerts">費用アラートを確認</a>
        </div>
        <div id="cost-recalculation" aria-live="polite"></div>
    </section>

    <section class="panel cost-config" id="cost-configuration" aria-labelledby="cost-config-heading">
        <div class="panel-head"><h3 class="panel-title" id="cost-config-heading" tabindex="-1">課金設定</h3><span class="panel-meta" id="cost-config-state">読み込んでいます。</span></div>
        <p class="monitor-subtle">組み込み料金表とローカル設定の確認済み情報を表示します。</p>
        <div id="cost-budget-state"></div>
        <div id="cost-catalog" class="cost-catalog-list"></div>
        <button type="button" class="monitor-btn" id="cost-catalog-next" hidden>料金プランの続き</button>
        <form id="cost-config-form" aria-label="課金設定の変更">
            <div class="cost-filter-grid">
                <label>取得元<input id="cost-config-surface" maxlength="128" autocomplete="off" /></label>
                <label>アプリのバージョン<input id="cost-config-version" maxlength="64" autocomplete="off" /></label>
                <label>アダプター機能<input id="cost-config-adapter" maxlength="64" autocomplete="off" /></label>
                <label>料金プラン<select id="cost-config-entry"><option value="">現在の割り当てを維持</option></select></label>
                <label>提供元<input id="cost-config-provider" readonly /></label>
                <label>課金方式<input id="cost-config-mode" readonly /></label>
                <label>料金体系<input id="cost-config-route" readonly /></label>
            </div>
            <label><input type="checkbox" id="cost-config-clear-sources" aria-describedby="cost-clear-sources-note" /> 取得元の割り当てをすべて削除</label>
            <p class="monitor-subtle" id="cost-clear-sources-note">選択すると取得元の編集を無効にします。「変更を確認」で削除内容を確認できます。</p>
            <fieldset class="cost-budget-fieldset">
                <legend>セッション予算</legend>
                <label><input type="checkbox" id="cost-budget-enabled" /> セッション予算を設定</label>
                <label><input type="checkbox" id="cost-budget-active" checked /> 有効</label>
                <label>警告額（USD）<input type="text" inputmode="decimal" id="cost-budget-warning" value="10" maxlength="32" /></label>
                <label>重大警告額（USD）<input type="text" inputmode="decimal" id="cost-budget-critical" value="20" maxlength="32" /></label>
                <label>最低算出率（bps、10000＝100%）<input type="number" id="cost-budget-coverage" value="10000" min="0" max="10000" /></label>
            </fieldset>
            <fieldset class="cost-budget-fieldset">
                <legend>日別予算（UTC）</legend>
                <label><input type="checkbox" id="cost-budget-daily-enabled" /> 日別予算を設定</label>
                <label><input type="checkbox" id="cost-budget-daily-active" checked /> 有効</label>
                <label>警告額（USD）<input type="text" inputmode="decimal" id="cost-budget-daily-warning" value="50" maxlength="32" /></label>
                <label>重大警告額（USD）<input type="text" inputmode="decimal" id="cost-budget-daily-critical" value="100" maxlength="32" /></label>
                <label>最低算出率（bps、10000＝100%）<input type="number" id="cost-budget-daily-coverage" value="10000" min="0" max="10000" /></label>
            </fieldset>
            <fieldset class="cost-budget-fieldset">
                <legend>直近期間の予算</legend>
                <label><input type="checkbox" id="cost-budget-period-enabled" /> 直近期間の予算を設定</label>
                <label><input type="checkbox" id="cost-budget-period-active" checked /> 有効</label>
                <label>警告額（USD）<input type="text" inputmode="decimal" id="cost-budget-period-warning" value="200" maxlength="32" /></label>
                <label>重大警告額（USD）<input type="text" inputmode="decimal" id="cost-budget-period-critical" value="400" maxlength="32" /></label>
                <label>最低算出率（bps、10000＝100%）<input type="number" id="cost-budget-period-coverage" value="10000" min="0" max="10000" /></label>
                <label>日数<input type="number" id="cost-budget-period-days" value="30" min="2" max="366" /></label>
            </fieldset>
            <div class="cost-action-row">
                <button type="submit" class="monitor-btn" id="cost-preview">変更を確認</button>
                <button type="button" class="monitor-btn monitor-btn-primary" id="cost-commit" disabled>変更を保存</button>
            </div>
        </form>
        <div id="cost-preview-result" aria-live="polite"></div>
    </section>
    <p id="cost-live" class="doctor-live" role="status" aria-live="polite" aria-atomic="true"></p>
</section>

<script src="/costs.js" defer></script>
