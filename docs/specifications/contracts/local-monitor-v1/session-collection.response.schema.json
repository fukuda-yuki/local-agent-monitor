{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/copilot-agent-observability/local-monitor-v1/session-collection.response.schema.json",
  "title": "local-monitor-sessions.response.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workspace_revision", "items", "next_cursor"],
  "properties": {
    "schema_version": {"const": "local-monitor-sessions.response.v1"},
    "workspace_revision": {"$ref": "#/$defs/revision"},
    "items": {"type": "array", "minItems": 0, "maxItems": 200, "items": {"$ref": "#/$defs/item"}},
    "next_cursor": {"type": ["string", "null"], "minLength": 147, "maxLength": 147}
  },
  "$defs": {
    "revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uuidv7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "factState": {"enum": ["recorded", "not_observed", "source_unsupported", "capture_gap", "certification_pending", "not_captured", "expired", "redacted", "malformed", "oversized", "inconsistent", "projection_invalid"]},
    "nullableNonnegativeInteger": {"type": ["integer", "null"], "minimum": 0},
    "countFact": {
      "type": "object", "additionalProperties": false, "required": ["state", "count"],
      "properties": {"state": {"$ref": "#/$defs/factState"}, "count": {"$ref": "#/$defs/nullableNonnegativeInteger"}},
      "allOf": [{"if": {"properties": {"state": {"const": "recorded"}}}, "then": {"properties": {"count": {"type": "integer", "minimum": 0}}}, "else": {"properties": {"count": {"type": "null"}}}}]
    },
    "tokenComponent": {
      "type": "object", "additionalProperties": false, "required": ["state", "value"],
      "properties": {"state": {"$ref": "#/$defs/factState"}, "value": {"$ref": "#/$defs/nullableNonnegativeInteger"}}
    },
    "ratioComponent": {
      "type": "object", "additionalProperties": false, "required": ["state", "value"],
      "properties": {"state": {"$ref": "#/$defs/factState"}, "value": {"type": ["integer", "null"], "minimum": 0, "maximum": 10000}}
    },
    "stringFact": {
      "type": "object", "additionalProperties": false, "required": ["state", "values"],
      "properties": {"state": {"$ref": "#/$defs/factState"}, "values": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["session_id", "assignment", "archive", "label", "status", "completeness", "source", "model", "summary", "tokens", "timing", "capture_notes", "workspace_revision"],
      "properties": {
        "session_id": {"$ref": "#/$defs/uuidv7"},
        "observed_activity": {"type":"object","additionalProperties":false,"required":["started_at","ended_at","duration_ms"],"properties":{"started_at":{"type":"string","format":"date-time"},"ended_at":{"type":"string","format":"date-time"},"duration_ms":{"type":"integer","minimum":0}}}, "assignment": {
          "type": "object", "additionalProperties": false,
          "required": ["state", "authority", "revision", "repository_id", "candidate_repository_ids"],
          "properties": {
            "state": {"enum": ["assigned", "unassigned", "explicitly_unassigned", "conflict"]},
            "authority": {"enum": ["automatic", "manual", "none"]},
            "revision": {"type": "integer", "minimum": 0},
            "repository_id": {"oneOf": [{"$ref": "#/$defs/uuidv7"}, {"type": "null"}]},
            "candidate_repository_ids": {"type": "array", "minItems": 0, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/uuidv7"}}
          }
        },
        "archive": {
          "type": "object", "additionalProperties": false, "required": ["state", "revision", "effectively_eligible", "exclusion_reason"],
          "properties": {
            "state": {"enum": ["active", "archived"]}, "revision": {"type": "integer", "minimum": 0},
            "effectively_eligible": {"type": "boolean"}, "exclusion_reason": {"enum": [null, "session_archived", "repository_archived"]}
          },
          "allOf": [{"if": {"properties": {"exclusion_reason": {"type": "null"}}}, "then": {"properties": {"effectively_eligible": {"const": true}}}, "else": {"properties": {"effectively_eligible": {"const": false}}}}]
        },
        "label": {
          "type": "object", "additionalProperties": false, "required": ["state", "text"],
          "properties": {"state": {"$ref": "#/$defs/factState"}, "text": {"type": ["string", "null"], "minLength": 1, "maxLength": 160}},
          "allOf": [{"if": {"properties": {"state": {"const": "recorded"}}}, "then": {"properties": {"text": {"type": "string", "minLength": 1, "maxLength": 160}}}, "else": {"properties": {"text": {"type": "null"}}}}]
        },
        "status": {"enum": ["active", "completed", "failed", "unknown"]},
        "completeness": {"enum": ["unbound", "partial", "rich", "full"]},
        "source": {"allOf": [{"$ref": "#/$defs/stringFact"}, {"properties": {"values": {"maxItems": 5}}}]},
        "model": {"allOf": [{"$ref": "#/$defs/stringFact"}, {"properties": {"values": {"maxItems": 16}}}]},
        "summary": {
          "type": "object", "additionalProperties": false, "required": ["skill", "tool", "subagent", "error", "retry"],
          "properties": {"skill": {"$ref": "#/$defs/countFact"}, "tool": {"$ref": "#/$defs/countFact"}, "subagent": {"$ref": "#/$defs/countFact"}, "error": {"$ref": "#/$defs/countFact"}, "retry": {"$ref": "#/$defs/countFact"}}
        },
        "tokens": {
          "type": "object", "additionalProperties": false,
          "required": ["authority", "state", "available_execution_count", "total_execution_count", "input", "output", "total", "reasoning", "cache_read", "cache_creation", "new_input", "cache_read_ratio_basis_points"],
          "properties": {
            "authority": {"enum": ["session_run", "llm_span", "mixed", "none"]}, "state": {"$ref": "#/$defs/factState"},
            "available_execution_count": {"type": "integer", "minimum": 0}, "total_execution_count": {"type": "integer", "minimum": 0},
            "input": {"$ref": "#/$defs/tokenComponent"}, "output": {"$ref": "#/$defs/tokenComponent"}, "total": {"$ref": "#/$defs/tokenComponent"},
            "reasoning": {"$ref": "#/$defs/tokenComponent"}, "cache_read": {"$ref": "#/$defs/tokenComponent"}, "cache_creation": {"$ref": "#/$defs/tokenComponent"},
            "new_input": {"$ref": "#/$defs/tokenComponent"}, "cache_read_ratio_basis_points": {"$ref": "#/$defs/ratioComponent"}, "observed_components": {"type":"object","additionalProperties":false,"required":["input","output","total","reasoning","cache_read","cache_creation","cache_read_ratio_basis_points"],"properties":{"input":{"type":"object","additionalProperties":false,"required":["subtotal","observed_call_count","applicable_call_count","paired_input"],"properties":{"subtotal":{"$ref":"#/$defs/tokenComponent"},"observed_call_count":{"type":"integer","minimum":0},"applicable_call_count":{"type":"integer","minimum":0},"paired_input":{"type":["integer","null"],"minimum":0}}},"output":{"type":"object","additionalProperties":false,"required":["subtotal","observed_call_count","applicable_call_count","paired_input"],"properties":{"subtotal":{"$ref":"#/$defs/tokenComponent"},"observed_call_count":{"type":"integer","minimum":0},"applicable_call_count":{"type":"integer","minimum":0},"paired_input":{"type":["integer","null"],"minimum":0}}},"total":{"type":"object","additionalProperties":false,"required":["subtotal","observed_call_count","applicable_call_count","paired_input"],"properties":{"subtotal":{"$ref":"#/$defs/tokenComponent"},"observed_call_count":{"type":"integer","minimum":0},"applicable_call_count":{"type":"integer","minimum":0},"paired_input":{"type":["integer","null"],"minimum":0}}},"reasoning":{"type":"object","additionalProperties":false,"required":["subtotal","observed_call_count","applicable_call_count","paired_input"],"properties":{"subtotal":{"$ref":"#/$defs/tokenComponent"},"observed_call_count":{"type":"integer","minimum":0},"applicable_call_count":{"type":"integer","minimum":0},"paired_input":{"type":["integer","null"],"minimum":0}}},"cache_read":{"type":"object","additionalProperties":false,"required":["subtotal","observed_call_count","applicable_call_count","paired_input"],"properties":{"subtotal":{"$ref":"#/$defs/tokenComponent"},"observed_call_count":{"type":"integer","minimum":0},"applicable_call_count":{"type":"integer","minimum":0},"paired_input":{"type":["integer","null"],"minimum":0}}},"cache_creation":{"type":"object","additionalProperties":false,"required":["subtotal","observed_call_count","applicable_call_count","paired_input"],"properties":{"subtotal":{"$ref":"#/$defs/tokenComponent"},"observed_call_count":{"type":"integer","minimum":0},"applicable_call_count":{"type":"integer","minimum":0},"paired_input":{"type":["integer","null"],"minimum":0}}},"cache_read_ratio_basis_points":{"type":"object","additionalProperties":false,"required":["subtotal","observed_call_count","applicable_call_count","paired_input"],"properties":{"subtotal":{"$ref":"#/$defs/ratioComponent"},"observed_call_count":{"type":"integer","minimum":0},"applicable_call_count":{"type":"integer","minimum":0},"paired_input":{"type":["integer","null"],"minimum":0}}}}}
          }
        },
        "timing": {
          "type": "object", "additionalProperties": false, "required": ["state", "started_at", "ended_at", "last_seen_at", "duration_ms"],
          "properties": {
            "state": {"$ref": "#/$defs/factState"},
            "started_at": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}\\+00:00$"},
            "ended_at": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}\\+00:00$"},
            "last_seen_at": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}\\+00:00$"},
            "duration_ms": {"$ref": "#/$defs/nullableNonnegativeInteger"}
          }
        },
        "capture_notes": {"type": "array", "minItems": 0, "maxItems": 16, "uniqueItems": true, "items": {"enum": ["raw_content_not_captured", "raw_content_expired", "source_unsupported", "capture_gap", "certification_pending", "projection_invalid", "token_inconsistent", "cache_inconsistent"]}},
        "workspace_revision": {"$ref": "#/$defs/revision"}
      }
    }
  }
}
