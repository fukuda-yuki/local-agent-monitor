{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/copilot-agent-observability/local-monitor-v1/session-timeline.response.schema.json",
  "title": "local-monitor-session-timeline.response.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workspace_revision", "session_id", "execution_id", "parent_node_id", "items", "next_cursor"],
  "properties": {
    "schema_version": {"const": "local-monitor-session-timeline.response.v1"},
    "workspace_revision": {"$ref": "#/$defs/revision"},
    "session_id": {"$ref": "#/$defs/uuidv7"},
    "execution_id": {"oneOf": [{"$ref": "#/$defs/uuidv7"}, {"type": "null"}]},
    "parent_node_id": {"oneOf": [{"$ref": "#/$defs/nodeId"}, {"type": "null"}]},
    "items": {"type": "array", "minItems": 0, "maxItems": 200, "items": {"$ref": "#/$defs/item"}},
    "next_cursor": {"type": ["string", "null"], "minLength": 159, "maxLength": 159, "pattern": "^[A-Za-z0-9_-]{158}[AEIMQUYcgkosw048]$"}
  },
  "allOf": [{"if": {"properties": {"execution_id": {"type": "null"}}, "required": ["execution_id"]}, "then": {"properties": {"parent_node_id": {"type": "null"}}}}],
  "$defs": {
    "revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uuidv7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "nodeId": {"type": "string", "pattern": "^node-[0-9a-f]{32}$"},
    "instant": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}\\+00:00$"},
    "factState": {"enum": ["recorded", "not_observed", "source_unsupported", "capture_gap", "certification_pending", "not_captured", "expired", "redacted", "malformed", "oversized", "inconsistent", "projection_invalid"]},
    "nullableCount": {"type": ["integer", "null"], "minimum": 0},
    "countFact": {"type": "object", "additionalProperties": false, "required": ["state", "count"], "properties": {"state": {"$ref": "#/$defs/factState"}, "count": {"$ref": "#/$defs/nullableCount"}}, "allOf": [{"if": {"properties": {"state": {"const": "recorded"}}, "required": ["state"]}, "then": {"properties": {"count": {"type": "integer", "minimum": 0}}}, "else": {"properties": {"count": {"type": "null"}}}}]},
    "tokenComponent": {"type": "object", "additionalProperties": false, "required": ["state", "value"], "properties": {"state": {"$ref": "#/$defs/factState"}, "value": {"$ref": "#/$defs/nullableCount"}}},
    "ratioComponent": {"type": "object", "additionalProperties": false, "required": ["state", "value"], "properties": {"state": {"$ref": "#/$defs/factState"}, "value": {"type": ["integer", "null"], "minimum": 0, "maximum": 10000}}},
    "tokens": {"type": "object", "additionalProperties": false, "required": ["authority", "state", "available_execution_count", "total_execution_count", "input", "output", "total", "reasoning", "cache_read", "cache_creation", "new_input", "cache_read_ratio_basis_points"], "properties": {"authority": {"enum": ["session_run", "llm_span", "mixed", "none"]}, "state": {"$ref": "#/$defs/factState"}, "available_execution_count": {"type": "integer", "minimum": 0}, "total_execution_count": {"type": "integer", "minimum": 0}, "input": {"$ref": "#/$defs/tokenComponent"}, "output": {"$ref": "#/$defs/tokenComponent"}, "total": {"$ref": "#/$defs/tokenComponent"}, "reasoning": {"$ref": "#/$defs/tokenComponent"}, "cache_read": {"$ref": "#/$defs/tokenComponent"}, "cache_creation": {"$ref": "#/$defs/tokenComponent"}, "new_input": {"$ref": "#/$defs/tokenComponent"}, "cache_read_ratio_basis_points": {"$ref": "#/$defs/ratioComponent"}}},
    "activity": {"type": "object", "additionalProperties": false, "required": ["skill", "tool", "subagent", "error", "retry"], "properties": {"skill": {"$ref": "#/$defs/countFact"}, "tool": {"$ref": "#/$defs/countFact"}, "subagent": {"$ref": "#/$defs/countFact"}, "error": {"$ref": "#/$defs/countFact"}, "retry": {"$ref": "#/$defs/countFact"}}},
    "timing": {"type": "object", "additionalProperties": false, "required": ["state", "started_at", "ended_at", "duration_ms"], "properties": {"state": {"enum": ["recorded", "missing", "invalid"]}, "started_at": {"oneOf": [{"$ref": "#/$defs/instant"}, {"type": "null"}]}, "ended_at": {"oneOf": [{"$ref": "#/$defs/instant"}, {"type": "null"}]}, "duration_ms": {"$ref": "#/$defs/nullableCount"}}, "oneOf": [{"properties": {"state": {"const": "recorded"}, "started_at": {"$ref": "#/$defs/instant"}}, "required": ["state", "started_at"], "oneOf": [{"properties": {"ended_at": {"type": "null"}, "duration_ms": {"type": "null"}}}, {"properties": {"ended_at": {"$ref": "#/$defs/instant"}, "duration_ms": {"type": "integer", "minimum": 0}}}]}, {"properties": {"state": {"enum": ["missing", "invalid"]}, "started_at": {"type": "null"}, "ended_at": {"type": "null"}, "duration_ms": {"type": "null"}}, "required": ["state", "started_at", "ended_at", "duration_ms"]}]},
    "name": {"type": "object", "additionalProperties": false, "required": ["state", "text"], "properties": {"state": {"enum": ["recorded", "not_observed", "invalid"]}, "text": {"type": ["string", "null"], "minLength": 1}}, "allOf": [{"if": {"properties": {"state": {"const": "recorded"}}, "required": ["state"]}, "then": {"properties": {"text": {"type": "string", "minLength": 1}}}, "else": {"properties": {"text": {"type": "null"}}}}]},
    "contentPart": {"enum": ["instruction", "tool_input", "tool_result", "error_message", "subagent_input", "event_content"]},
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["node_id", "execution_id", "parent_node_id", "relationship_authority", "kind", "name", "lifecycle", "status", "timing", "activity", "tokens", "child_count", "content_parts"],
      "properties": {"node_id": {"$ref": "#/$defs/nodeId"}, "execution_id": {"$ref": "#/$defs/uuidv7"}, "parent_node_id": {"oneOf": [{"$ref": "#/$defs/nodeId"}, {"type": "null"}]}, "relationship_authority": {"enum": ["exact", "explicit", "unknown"]}, "kind": {"enum": ["execution", "agent", "skill", "tool", "subagent", "event", "error", "retry", "permission", "unknown_relation_group"]}, "name": {"$ref": "#/$defs/name"}, "lifecycle": {"enum": ["selected", "started", "completed", "failed", "deselected", "unknown"]}, "status": {"enum": ["active", "completed", "failed", "unknown"]}, "timing": {"$ref": "#/$defs/timing"}, "activity": {"$ref": "#/$defs/activity"}, "tokens": {"$ref": "#/$defs/tokens"}, "child_count": {"type": "integer", "minimum": 0, "maximum": 4096}, "content_parts": {"type": "array", "minItems": 0, "maxItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/contentPart"}}}
    }
  }
}
