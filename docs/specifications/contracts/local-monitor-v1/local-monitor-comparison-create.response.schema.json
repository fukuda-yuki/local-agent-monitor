{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/copilot-agent-observability/local-monitor-v1/local-monitor-comparison-create.response.schema.json",
  "title": "local-monitor-comparison-create.response.v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "comparison_id", "location", "receipt_sha256", "created_at", "expires_at"],
  "properties": {
    "schema_version": {"const": "local-monitor-comparison-create.response.v1"},
    "comparison_id": {"$ref": "#/$defs/uuidv7"},
    "location": {"type": "string", "pattern": "^/repositories/[0-9a-f-]{36}/comparisons/[0-9a-f-]{36}$"},
    "receipt_sha256": {"$ref": "#/$defs/digest"},
    "created_at": {"$ref": "#/$defs/instant"},
    "expires_at": {"$ref": "#/$defs/instant"}
  },
  "$defs": {"uuidv7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "instant": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}\\+00:00$"}}
}
