{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.local/copilot-agent-observability/local-monitor-v1/repository-collection.response.schema.json","title":"local-monitor-repositories.response.v1","type":"object","additionalProperties":false,"required":["schema_version","workspace_revision","repositories","all_session_count","unassigned_active_session_count","archived_repository_count","next_cursor"],"properties":{"schema_version":{"const":"local-monitor-repositories.response.v1"},"workspace_revision":{"$ref":"#/$defs/revision"},"repositories":{"type":"array","minItems":0,"maxItems":200,"items":{"$ref":"#/$defs/repository"}},"all_session_count":{"$ref":"#/$defs/count"},"unassigned_active_session_count":{"$ref":"#/$defs/count"},"archived_repository_count":{"$ref":"#/$defs/count"},"next_cursor":{"type":["string","null"],"minLength":135,"maxLength":135,"pattern":"^[A-Za-z0-9_-]{135}$"}},"$defs":{"count":{"type":"integer","minimum":0},"revision":{"type":"string","pattern":"^[0-9a-f]{64}$"},"uuidv7":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},"canonicalUtc":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}\\+00:00$"},"repository":{"type":"object","additionalProperties":false,"required":["repository_id","display_name","archive_state","archive_revision","active_session_count","last_observed_at","assignment_conflict_count","repository_revision"],"properties":{"repository_id":{"$ref":"#/$defs/uuidv7"},"display_name":{"type":"string","minLength":1,"maxLength":200},"archive_state":{"enum":["active","archived"]},"archive_revision":{"$ref":"#/$defs/count"},"active_session_count":{"$ref":"#/$defs/count"},"last_observed_at":{"oneOf":[{"$ref":"#/$defs/canonicalUtc"},{"type":"null"}]},"assignment_conflict_count":{"$ref":"#/$defs/count"},"repository_revision":{"$ref":"#/$defs/revision"}}}}}