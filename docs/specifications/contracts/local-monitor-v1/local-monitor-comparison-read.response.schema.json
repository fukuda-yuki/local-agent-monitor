{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/copilot-agent-observability/local-monitor-v1/local-monitor-comparison-read.response.schema.json",
  "title": "local-monitor-comparison-read.response.v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "comparison_id", "repository_id", "receipt_sha256", "created_at", "expires_at", "cohorts", "sections", "results"],
  "properties": {
    "schema_version": {"const": "local-monitor-comparison-read.response.v1"},
    "comparison_id": {"$ref": "#/$defs/uuidv7"}, "repository_id": {"$ref": "#/$defs/uuidv7"},
    "receipt_sha256": {"$ref": "#/$defs/digest"}, "created_at": {"$ref": "#/$defs/instant"}, "expires_at": {"$ref": "#/$defs/instant"},
    "cohorts": {"type": "object", "additionalProperties": false, "required": ["a", "b"], "properties": {"a": {"$ref": "#/$defs/cohort"}, "b": {"$ref": "#/$defs/cohort"}}},
    "sections": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/section"}},
    "results": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/result"}}
  },
  "$defs": {
    "uuidv7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "instant": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}\\+00:00$"},
    "cohort": {"type": "object", "additionalProperties": false, "required": ["label", "session_ids", "included_count"], "properties": {"label": {"type": "string", "minLength": 1, "maxLength": 20}, "session_ids": {"type": "array", "minItems": 1, "maxItems": 199, "uniqueItems": true, "items": {"$ref": "#/$defs/uuidv7"}}, "included_count": {"type": "integer", "minimum": 1, "maximum": 199}}},
    "sectionKey": {"enum": ["scope", "tokens", "input_tokens", "time_execution", "skill", "tool", "subagent", "error_retry", "conditions"]},
    "section": {"type": "object", "additionalProperties": false, "required": ["ordinal", "key", "label"], "properties": {"ordinal": {"type": "integer", "minimum": 1, "maximum": 9}, "key": {"$ref": "#/$defs/sectionKey"}, "label": {"type": "string", "minLength": 1, "maxLength": 40}}},
    "fact": {"type": "object", "additionalProperties": false, "required": ["state", "value"], "properties": {"state": {"enum": ["recorded", "not_observed", "source_unsupported", "capture_gap", "certification_pending", "projection_unavailable"]}, "value": {"type": ["string", "null"], "maxLength": 200}}},
    "result": {"type": "object", "additionalProperties": false, "required": ["result_ordinal", "section_key", "metric_key", "field_key", "a", "b", "absolute_difference", "relative_difference_percent"], "properties": {"result_ordinal": {"type": "integer", "minimum": 1}, "section_key": {"$ref": "#/$defs/sectionKey"}, "metric_key": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,79}$"}, "field_key": {"enum": [null, "value", "available_count", "median", "minimum", "maximum", "total", "absolute_difference", "relative_difference_percent", "condition", "count", "duration_ms", "input_tokens", "output_tokens", "total_tokens", "cache_read", "cache_creation", "new_input", "error_count", "retry_count"]}, "a": {"$ref": "#/$defs/fact"}, "b": {"$ref": "#/$defs/fact"}, "absolute_difference": {"$ref": "#/$defs/fact"}, "relative_difference_percent": {"$ref": "#/$defs/fact"}}}
  }
}
