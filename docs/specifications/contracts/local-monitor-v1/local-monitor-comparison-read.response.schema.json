{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.local/copilot-agent-observability/local-monitor-v1/local-monitor-comparison-read.response.schema.json", "title": "local-monitor-comparison-read.response.v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "comparison_id", "repository_id", "receipt_sha256", "created_at", "expires_at", "cohorts", "sections", "results"],
  "properties": {"schema_version": {"const": "local-monitor-comparison-read.response.v1"}, "comparison_id": {"$ref": "#/$defs/uuidv7"}, "repository_id": {"$ref": "#/$defs/uuidv7"}, "receipt_sha256": {"$ref": "#/$defs/digest"}, "created_at": {"$ref": "#/$defs/instant"}, "expires_at": {"$ref": "#/$defs/instant"}, "cohorts": {"type": "object", "additionalProperties": false, "required": ["a", "b"], "properties": {"a": {"$ref": "#/$defs/cohortA"}, "b": {"$ref": "#/$defs/cohortB"}}}, "sections": {"type": "array", "minItems": 9, "maxItems": 9, "prefixItems": [{"$ref": "#/$defs/section1"}, {"$ref": "#/$defs/section2"}, {"$ref": "#/$defs/section3"}, {"$ref": "#/$defs/section4"}, {"$ref": "#/$defs/section5"}, {"$ref": "#/$defs/section6"}, {"$ref": "#/$defs/section7"}, {"$ref": "#/$defs/section8"}, {"$ref": "#/$defs/section9"}], "items": false}, "results": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/result"}}},
  "$defs": {
    "uuidv7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "instant": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}\\+00:00$"},
    "cohortA": {"type": "object", "additionalProperties": false, "required": ["label", "session_ids", "included_count"], "properties": {"label": {"const": "基準"}, "session_ids": {"type": "array", "minItems": 1, "maxItems": 199, "uniqueItems": true, "items": {"$ref": "#/$defs/uuidv7"}}, "included_count": {"type": "integer", "minimum": 1, "maximum": 199}}},
    "cohortB": {"type": "object", "additionalProperties": false, "required": ["label", "session_ids", "included_count"], "properties": {"label": {"const": "比較対象"}, "session_ids": {"type": "array", "minItems": 1, "maxItems": 199, "uniqueItems": true, "items": {"$ref": "#/$defs/uuidv7"}}, "included_count": {"type": "integer", "minimum": 1, "maximum": 199}}},
    "sectionKey": {"enum": ["target", "tokens", "input_token_breakdown", "time_and_execution", "skills", "tools", "subagents", "errors_and_retries", "conditions"]},
    "section": {"type": "object", "additionalProperties": false, "required": ["ordinal", "key", "label"], "properties": {"ordinal": {"type": "integer", "minimum": 1, "maximum": 9}, "key": {"$ref": "#/$defs/sectionKey"}, "label": {"enum": ["対象", "トークン", "入力トークンの内訳", "時間・実行量", "スキル", "ツール", "サブエージェント", "エラー・再試行", "比較条件"]}}},
    "section1": {"$ref": "#/$defs/section", "properties": {"ordinal": {"const": 1}, "key": {"const": "target"}, "label": {"const": "対象"}}}, "section2": {"$ref": "#/$defs/section", "properties": {"ordinal": {"const": 2}, "key": {"const": "tokens"}, "label": {"const": "トークン"}}}, "section3": {"$ref": "#/$defs/section", "properties": {"ordinal": {"const": 3}, "key": {"const": "input_token_breakdown"}, "label": {"const": "入力トークンの内訳"}}}, "section4": {"$ref": "#/$defs/section", "properties": {"ordinal": {"const": 4}, "key": {"const": "time_and_execution"}, "label": {"const": "時間・実行量"}}}, "section5": {"$ref": "#/$defs/section", "properties": {"ordinal": {"const": 5}, "key": {"const": "skills"}, "label": {"const": "スキル"}}}, "section6": {"$ref": "#/$defs/section", "properties": {"ordinal": {"const": 6}, "key": {"const": "tools"}, "label": {"const": "ツール"}}}, "section7": {"$ref": "#/$defs/section", "properties": {"ordinal": {"const": 7}, "key": {"const": "subagents"}, "label": {"const": "サブエージェント"}}}, "section8": {"$ref": "#/$defs/section", "properties": {"ordinal": {"const": 8}, "key": {"const": "errors_and_retries"}, "label": {"const": "エラー・再試行"}}}, "section9": {"$ref": "#/$defs/section", "properties": {"ordinal": {"const": 9}, "key": {"const": "conditions"}, "label": {"const": "比較条件"}}},
    "value": {"type": "object", "additionalProperties": false, "required": ["key", "value"], "properties": {"key": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9_.:/-]{1,128}$"}, "value": {"type": "string", "minLength": 1, "maxLength": 16384}}},
    "result": {"type": "object", "additionalProperties": false, "required": ["result_ordinal", "section_key", "row_kind", "row_key", "values"], "properties": {"result_ordinal": {"type": "integer", "minimum": 1}, "section_key": {"$ref": "#/$defs/sectionKey"}, "row_kind": {"const": "scalar"}, "row_key": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,79}$"}, "values": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/value"}}}}
  }
}
