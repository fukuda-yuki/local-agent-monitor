{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/copilot-agent-observability/local-monitor-v1/session-summary.response.schema.json",
  "title": "local-monitor-session-summary.response.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workspace_revision", "session", "executions", "technical_references"],
  "properties": {
    "schema_version": {"const": "local-monitor-session-summary.response.v1"},
    "workspace_revision": {"$ref": "#/$defs/revision"},
    "session": {"$ref": "#/$defs/session"},
    "executions": {"type": "array", "minItems": 0, "maxItems": 256, "items": {"$ref": "#/$defs/execution"}},
    "technical_references": {"$ref": "#/$defs/sessionReferences"}
  },
  "$defs": {
    "revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uuidv7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "nodeId": {"type": "string", "pattern": "^node-[0-9a-f]{32}$"},
    "instant": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}\\+00:00$"},
    "factState": {"enum": ["recorded", "not_observed", "source_unsupported", "capture_gap", "certification_pending", "not_captured", "expired", "redacted", "malformed", "oversized", "inconsistent", "projection_invalid"]},
    "nullableCount": {"type": ["integer", "null"], "minimum": 0},
    "countFact": {
      "type": "object", "additionalProperties": false, "required": ["state", "count"],
      "properties": {"state": {"$ref": "#/$defs/factState"}, "count": {"$ref": "#/$defs/nullableCount"}},
      "allOf": [{"if": {"properties": {"state": {"const": "recorded"}}, "required": ["state"]}, "then": {"properties": {"count": {"type": "integer", "minimum": 0}}}, "else": {"properties": {"count": {"type": "null"}}}}]
    },
    "stringFact": {
      "type": "object", "additionalProperties": false, "required": ["state", "values"],
      "properties": {"state": {"$ref": "#/$defs/factState"}, "values": {"type": "array", "minItems": 0, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}}
    },
    "tokenComponent": {
      "type": "object", "additionalProperties": false, "required": ["state", "value"],
      "properties": {"state": {"$ref": "#/$defs/factState"}, "value": {"$ref": "#/$defs/nullableCount"}}
    },
    "ratioComponent": {
      "type": "object", "additionalProperties": false, "required": ["state", "value"],
      "properties": {"state": {"$ref": "#/$defs/factState"}, "value": {"type": ["integer", "null"], "minimum": 0, "maximum": 10000}}
    },
    "tokens": {
      "type": "object", "additionalProperties": false,
      "required": ["authority", "state", "available_execution_count", "total_execution_count", "input", "output", "total", "reasoning", "cache_read", "cache_creation", "new_input", "cache_read_ratio_basis_points"],
      "properties": {
        "authority": {"enum": ["session_run", "llm_span", "mixed", "none"]}, "state": {"$ref": "#/$defs/factState"},
        "available_execution_count": {"type": "integer", "minimum": 0, "maximum": 256}, "total_execution_count": {"type": "integer", "minimum": 0, "maximum": 256},
        "input": {"$ref": "#/$defs/tokenComponent"}, "output": {"$ref": "#/$defs/tokenComponent"}, "total": {"$ref": "#/$defs/tokenComponent"},
        "reasoning": {"$ref": "#/$defs/tokenComponent"}, "cache_read": {"$ref": "#/$defs/tokenComponent"}, "cache_creation": {"$ref": "#/$defs/tokenComponent"},
        "new_input": {"$ref": "#/$defs/tokenComponent"}, "cache_read_ratio_basis_points": {"$ref": "#/$defs/ratioComponent"}
      }
    },
    "activity": {
      "type": "object", "additionalProperties": false, "required": ["skill", "tool", "subagent", "error", "retry"],
      "properties": {"skill": {"$ref": "#/$defs/countFact"}, "tool": {"$ref": "#/$defs/countFact"}, "subagent": {"$ref": "#/$defs/countFact"}, "error": {"$ref": "#/$defs/countFact"}, "retry": {"$ref": "#/$defs/countFact"}}
    },
    "assignment": {
      "type": "object", "additionalProperties": false, "required": ["state", "authority", "revision", "repository_id", "candidate_repository_ids"],
      "properties": {
        "state": {"enum": ["assigned", "unassigned", "explicitly_unassigned", "conflict"]}, "authority": {"enum": ["automatic", "manual", "none"]},
        "revision": {"type": "integer", "minimum": 0}, "repository_id": {"oneOf": [{"$ref": "#/$defs/uuidv7"}, {"type": "null"}]},
        "candidate_repository_ids": {"type": "array", "minItems": 0, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/uuidv7"}}
      }
    },
    "archive": {
      "type": "object", "additionalProperties": false, "required": ["state", "revision", "effectively_eligible", "exclusion_reason"],
      "properties": {"state": {"enum": ["active", "archived"]}, "revision": {"type": "integer", "minimum": 0}, "effectively_eligible": {"type": "boolean"}, "exclusion_reason": {"enum": [null, "session_archived", "repository_archived"]}}
    },
    "instruction": {
      "type": "object", "additionalProperties": false, "required": ["state", "label", "additional_count", "content_available"],
      "properties": {
        "state": {"enum": ["recorded", "not_observed", "not_captured", "expired", "invalid"]},
        "label": {"type": ["string", "null"], "minLength": 1, "maxLength": 160}, "additional_count": {"type": ["integer", "null"], "minimum": 0}, "content_available": {"type": "boolean"}
      },
      "allOf": [{"if": {"properties": {"state": {"const": "recorded"}}, "required": ["state"]}, "then": {"properties": {"label": {"type": "string", "minLength": 1, "maxLength": 160}}}, "else": {"properties": {"label": {"type": "null"}, "content_available": {"const": false}}}}]
    },
    "sessionTiming": {
      "type": "object", "additionalProperties": false, "required": ["state", "started_at", "ended_at", "last_seen_at", "duration_ms"],
      "properties": {"state": {"$ref": "#/$defs/factState"}, "started_at": {"oneOf": [{"$ref": "#/$defs/instant"}, {"type": "null"}]}, "ended_at": {"oneOf": [{"$ref": "#/$defs/instant"}, {"type": "null"}]}, "last_seen_at": {"oneOf": [{"$ref": "#/$defs/instant"}, {"type": "null"}]}, "duration_ms": {"$ref": "#/$defs/nullableCount"}}
    },
    "executionTiming": {
      "type": "object", "additionalProperties": false, "required": ["state", "started_at", "ended_at", "duration_ms"],
      "properties": {"state": {"enum": ["recorded", "missing", "invalid"]}, "started_at": {"oneOf": [{"$ref": "#/$defs/instant"}, {"type": "null"}]}, "ended_at": {"oneOf": [{"$ref": "#/$defs/instant"}, {"type": "null"}]}, "duration_ms": {"$ref": "#/$defs/nullableCount"}},
      "allOf": [{"if": {"properties": {"state": {"enum": ["missing", "invalid"]}}, "required": ["state"]}, "then": {"properties": {"started_at": {"type": "null"}, "ended_at": {"type": "null"}, "duration_ms": {"type": "null"}}}}]
    },
    "capture": {
      "type": "object", "additionalProperties": false, "required": ["state", "notes"],
      "properties": {"state": {"enum": ["complete", "partial", "not_observed", "invalid"]}, "notes": {"type": "array", "minItems": 0, "maxItems": 16, "uniqueItems": true, "items": {"enum": ["raw_content_not_captured", "raw_content_expired", "source_unsupported", "capture_gap", "certification_pending", "projection_invalid", "token_inconsistent", "cache_inconsistent"]}}}
    },
    "execution": {
      "type": "object", "additionalProperties": false, "required": ["execution_id", "node_id", "source", "model", "lifecycle", "status", "timing", "tokens", "activity", "child_count"],
      "properties": {"execution_id": {"$ref": "#/$defs/uuidv7"}, "node_id": {"$ref": "#/$defs/nodeId"}, "source": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}, "model": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}, "lifecycle": {"enum": ["selected", "started", "completed", "failed", "deselected", "unknown"]}, "status": {"enum": ["active", "completed", "failed", "unknown"]}, "timing": {"$ref": "#/$defs/executionTiming"}, "tokens": {"$ref": "#/$defs/tokens"}, "activity": {"$ref": "#/$defs/activity"}, "child_count": {"type": "integer", "minimum": 0, "maximum": 4096}}
    },
    "session": {
      "type": "object", "additionalProperties": false, "required": ["session_id", "status", "completeness", "assignment", "archive", "instruction", "source", "model", "version", "timing", "tokens", "activity", "capture"],
      "properties": {"session_id": {"$ref": "#/$defs/uuidv7"}, "status": {"enum": ["active", "completed", "failed", "unknown"]}, "completeness": {"enum": ["unbound", "partial", "rich", "full"]}, "assignment": {"$ref": "#/$defs/assignment"}, "archive": {"$ref": "#/$defs/archive"}, "instruction": {"$ref": "#/$defs/instruction"}, "source": {"$ref": "#/$defs/stringFact"}, "model": {"$ref": "#/$defs/stringFact"}, "version": {"$ref": "#/$defs/stringFact"}, "timing": {"$ref": "#/$defs/sessionTiming"}, "tokens": {"$ref": "#/$defs/tokens"}, "activity": {"$ref": "#/$defs/activity"}, "capture": {"$ref": "#/$defs/capture"}}
    },
    "sessionReferences": {
      "type": "object", "additionalProperties": false, "required": ["native_session_ids", "trace_ids"],
      "properties": {"native_session_ids": {"type": "array", "minItems": 0, "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}, "trace_ids": {"type": "array", "minItems": 0, "maxItems": 4096, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{32}$"}}}
    }
  }
}
