{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.local/copilot-agent-observability/local-monitor-v1/local-monitor-comparison-rows.response.schema.json", "title": "local-monitor-comparison-rows.response.v1",
  "type": "object", "additionalProperties": false, "required": ["schema_version", "comparison_id", "family", "items", "next_cursor"],
  "properties": {"schema_version": {"const": "local-monitor-comparison-rows.response.v1"}, "comparison_id": {"$ref": "#/$defs/uuidv7"}, "family": {"enum": ["skill", "tool", "subagent"]}, "items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/item"}}, "next_cursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 512}},
  "$defs": {"uuidv7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "value": {"type": "object", "additionalProperties": false, "required": ["key", "value"], "properties": {"key": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9_.:/-]{1,128}$"}, "value": {"type": "string", "minLength": 1, "maxLength": 16384}}}, "item": {"type": "object", "additionalProperties": false, "required": ["result_ordinal", "row_key", "display_name", "values"], "properties": {"result_ordinal": {"type": "integer", "minimum": 1}, "row_key": {"type": "string", "minLength": 1, "maxLength": 200}, "display_name": {"type": "string", "minLength": 1, "maxLength": 200}, "values": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/value"}}}}}
}
